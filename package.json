{
  "name": "zhijing",
  "productName": "知径",
  "version": "1.1.1",
  "description": "岗位方向学习路径 · 按天打卡",
  "author": {
    "name": "知径",
    "email": "wterenwang@users.noreply.github.com"
  },
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg zip --publish never"
  },
  "build": {
    "appId": "com.zhijing.app",
    "productName": "知径",
    "copyright": "Copyright © 知径",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "js/**/*",
      "css/**/*",
      "hub/**/*",
      "assets/**/*",
      "package.json",
      "!assets/mascot/*-blink.png",
      "!assets/mascot/*-talk.png",
      "!assets/splash-girl-blink.png",
      "!assets/splash-girl-halfblink.png",
      "!assets/splash-girl-talk.png"
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "知径",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Zhijing ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
